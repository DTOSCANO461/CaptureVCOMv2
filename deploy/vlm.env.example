# Copia a /opt/capturevcomv2/vlm.env (chmod 600). NO subir al repo.
# La misma API key que usa pc-agent para /heartbeat en el servidor central.
PC_API_KEY=PON_AQUI_LA_KEY_DEL_PC
CENTRAL_SERVER_URL=https://api.sb-tec.com

# Opcionales (defaults del verificador entre paréntesis):
# BYPASS_P=0.80        # score del detector a partir del cual va DIRECTO a la app
# VLM_WORKERS=6        # clips analizados en paralelo
